{
  "name": "trackside",
  "version": "1.0.5",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "icon:png": "sharp -i assets/logo.svg -o assets/icon.png --density 144 resize 1024 1024 -- flatten '#ffffff' && sharp -i assets/logo.svg -o assets/adaptive-icon.png --density 144 resize 1024 1024",
    "build:aab": "./scripts/build.aab.sh",
    "build:apk": "./scripts/build.apk.sh",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint App.tsx src --max-warnings=0",
    "complexity": "eslint App.tsx src --rule 'complexity: [\"error\", 10]' --max-warnings=0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "App.tsx",
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/integration/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/react": "~19.2.4",
    "expo": "~57.0.31",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "^19.2.3",
    "sharp-cli": "^6.1.0"
  }
}
