{
  "name": "trackside",
  "version": "1.1.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "icon:png": "sharp -i assets/logo.svg -o assets/icon.png --density 144 resize 1024 1024 -- flatten '#ffffff' && sharp -i assets/logo.svg -o assets/adaptive-icon.png --density 144 resize 1024 1024",
    "build:aab": "./scripts/build.aab.sh",
    "build:apk": "./scripts/build.apk.sh",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint App.tsx src --max-warnings=0",
    "complexity": "eslint App.tsx src --rule 'complexity: [\"error\", 10]' --max-warnings=0",
    "test:e2e": "mkdir -p reports/maestro && maestro test --format HTML --output reports/maestro/local-journal-e2e.html --test-output-dir reports/maestro/artifacts maestro/*.yaml"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "App.tsx",
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/integration/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/react": "~19.3.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "^19.3.0",
    "sharp-cli": "^6.1.0"
  }
}
