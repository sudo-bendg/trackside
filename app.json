{
  "expo": {
    "name": "Trackside",
    "slug": "trackside",
    "version": "1.0.9",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "dev.bengodfrey.trackside"
    },
    "extra": {
      "eas": {
        "projectId": "faf65796-0888-463d-95d2-47a61c93a4ea"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "gifEnabled": false,
            "webpEnabled": false
          }
        }
      ]
    ]
  }
}
